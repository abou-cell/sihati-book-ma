generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  PRACTITIONER
  ADMIN
}

enum ConsultationType {
  IN_PERSON
  VIDEO
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

enum NotificationChannel {
  PUSH
  EMAIL
  SMS
  WHATSAPP
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

enum NotificationType {
  APPOINTMENT_CONFIRMATION_PATIENT
  APPOINTMENT_CONFIRMATION_PRACTITIONER
  APPOINTMENT_CANCELLATION
  VIDEO_CONSULTATION_LINK
  APPOINTMENT_REMINDER_24H
  APPOINTMENT_REMINDER_2H
}

enum PaymentProvider {
  STRIPE
}

enum PaymentStatus {
  CHECKOUT_CREATED
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
}

enum MedicalDocumentStorageProvider {
  S3_PRIVATE
  LOCAL_PRIVATE
}

enum MedicalDocumentStatus {
  PENDING_UPLOAD
  AVAILABLE
  DELETED
}

model User {
  id           String   @id @default(cuid())
  role         UserRole
  email        String   @unique
  fullName     String
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  patientAppointments Appointment[]     @relation("PatientAppointments")
  payments            Payment[]
  medicalDocuments    MedicalDocument[] @relation("PatientMedicalDocuments")
}

model Practitioner {
  id                       String    @id
  name                     String
  specialty                String
  city                     String
  clinic                   String?
  consultationFee          Int?
  isVerified               Boolean   @default(false)
  acceptsVideoConsultation Boolean   @default(false)
  nextAvailableSlot        DateTime?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  reasons                ConsultationReason[]
  rules                  AvailabilityRule[]
  blockedDates           BlockedDate[]
  appointments           Appointment[]
  sharedMedicalDocuments MedicalDocument[]    @relation("PractitionerSharedMedicalDocuments")
}

model ConsultationReason {
  id                  String  @id
  practitionerId      String
  label               String
  inPersonPrice       Int
  videoPrice          Int?
  isVideoEnabled      Boolean @default(false)
  slotDurationMinutes Int

  practitioner Practitioner  @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model AvailabilityRule {
  id               String           @id
  practitionerId   String
  weekday          String
  startTime        String
  endTime          String
  breakStart       String?
  breakEnd         String?
  consultationType ConsultationType
  isActive         Boolean          @default(true)

  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
}

model BlockedDate {
  id             String  @id
  practitionerId String
  date           String
  reason         String?

  practitioner Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
}

model Appointment {
  id               String            @id
  patientId        String
  practitionerId   String
  reasonId         String
  consultationType ConsultationType
  startTime        DateTime
  endTime          DateTime
  status           AppointmentStatus
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  patient          User               @relation("PatientAppointments", fields: [patientId], references: [id], onDelete: Restrict)
  practitioner     Practitioner       @relation(fields: [practitionerId], references: [id], onDelete: Restrict)
  reason           ConsultationReason @relation(fields: [reasonId], references: [id], onDelete: Restrict)
  notifications    Notification[]
  payments         Payment[]
  medicalDocuments MedicalDocument[]

  @@index([practitionerId, startTime])
  @@index([patientId, status])
}

model MedicalDocument {
  id              String                         @id @default(cuid())
  patientId       String
  practitionerId  String?
  appointmentId   String?
  storageProvider MedicalDocumentStorageProvider
  objectKey       String                         @unique
  fileName        String
  mimeType        String
  sizeBytes       Int
  checksum        String
  status          MedicalDocumentStatus          @default(PENDING_UPLOAD)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  deletedAt       DateTime?

  patient      User          @relation("PatientMedicalDocuments", fields: [patientId], references: [id], onDelete: Restrict)
  practitioner Practitioner? @relation("PractitionerSharedMedicalDocuments", fields: [practitionerId], references: [id], onDelete: Restrict)
  appointment  Appointment?  @relation(fields: [appointmentId], references: [id], onDelete: Restrict)

  @@index([patientId, status, createdAt])
  @@index([practitionerId, status])
  @@index([appointmentId])
  @@index([deletedAt])
}

model Payment {
  id                      String          @id @default(cuid())
  provider                PaymentProvider
  providerSessionId       String?         @unique
  providerPaymentIntentId String?         @unique
  appointmentId           String
  userId                  String
  amount                  Int
  currency                String
  status                  PaymentStatus
  idempotencyKey          String          @unique
  rawProviderEventId      String?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Restrict)
  user        User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([appointmentId])
  @@index([userId])
  @@index([provider, status])
  @@index([rawProviderEventId])
}

model PaymentWebhookEvent {
  id              String          @id @default(cuid())
  provider        PaymentProvider
  providerEventId String          @unique
  eventType       String
  paymentId       String?
  processedAt     DateTime        @default(now())

  @@index([provider, eventType])
  @@index([paymentId])
}

model Notification {
  id            String              @id
  appointmentId String
  channel       NotificationChannel
  type          NotificationType?
  recipient     String?
  subject       String?
  message       String?
  status        NotificationStatus
  sentAt        DateTime?
  metadata      Json?

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

enum ExternalServiceProvider {
  STRIPE
  CLOUDFLARE_STREAM_WEBRTC
  FIREBASE
  SMTP
  SMS_PROVIDER
  PUSH_NOTIFICATIONS
  CLOUD_STORAGE
  GOOGLE_OAUTH
  FACEBOOK_OAUTH
}

model ServiceConfiguration {
  id               String                  @id @default(cuid())
  provider         ExternalServiceProvider @unique
  isEnabled        Boolean                 @default(false)
  displayName      String
  metadata         Json                    @default("{}")
  encryptedSecrets Json?
  secretPreview    Json                    @default("{}")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  updatedByUserId  String?

  @@index([isEnabled])
}
