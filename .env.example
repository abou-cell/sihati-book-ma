# -----------------------------------------------------------------------------
# Sihati environment configuration
# Copy this file to .env.local for local development.
# -----------------------------------------------------------------------------

# Public (safe to expose to the browser)
# Required now: YES
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Runtime mode
NODE_ENV=development

# Server-only secrets and service credentials
# Required now: NO (optional during local development)
# Required later: YES (mandatory in production)

# PostgreSQL database connection string used by Prisma.
# Local Docker default: postgresql://postgres:postgres@localhost:5432/sihati
# Production example: postgresql://sihati_app:<password>@<host>:5432/sihati?schema=public
# Keep production/staging values in a secret manager; never commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sihati

# App auth secret (use at least 32 characters)
AUTH_SECRET=dev_only_change_me_to_a_very_long_secret_key

# App encryption key for production-only encrypted data at rest.
# Generate a production value with: openssl rand -base64 32
APP_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Stripe Checkout and verified webhook handling. Use test-mode values locally.
# STRIPE_SECRET_KEY creates Checkout Sessions server-side; never expose it to the browser.
STRIPE_SECRET_KEY=sk_test_placeholder
# STRIPE_WEBHOOK_SECRET verifies the raw /api/stripe/webhook request body.
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Outbound email identity and provider key
EMAIL_FROM=noreply@example.com
RESEND_API_KEY=re_placeholder

# Shared production rate limiting (Redis/Upstash REST API compatible)
# Required in production so limits coordinate across all app instances.
RATE_LIMIT_REDIS_REST_URL=https://example-upstash-redis.upstash.io
RATE_LIMIT_REDIS_REST_TOKEN=replace_with_upstash_redis_rest_token

# Optional operational runtime settings
# Disable anonymous Next.js telemetry in local containers and production runtimes.
NEXT_TELEMETRY_DISABLED=1
# Docker/standalone runtime defaults; override only when your platform requires it.
PORT=3000
HOSTNAME=0.0.0.0

# Private medical document storage
# Use private buckets/volumes only; never expose the object namespace publicly.
MEDICAL_DOCUMENTS_STORAGE_PROVIDER=LOCAL_PRIVATE
MEDICAL_DOCUMENTS_STORAGE_BASE_URL=http://localhost:3000/api/private-medical-documents
# Signing secret for short-lived upload/download URLs. Generate with: openssl rand -base64 32
MEDICAL_DOCUMENTS_SIGNING_SECRET=replace_with_32_byte_random_secret
# Admin downloads are disabled by default. Enable only with a documented break-glass runbook.
MEDICAL_DOCUMENT_ADMIN_DOWNLOADS_ENABLED=false
