{
  "name": "sihati",
  "version": "0.1.0",
  "private": true,
  "description": "Sihati - Moroccan medical appointment booking platform",
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-next.mjs",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prisma:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/sihati} prisma validate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "check": "npm run lint && npm run typecheck && npm test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:prod": "npm audit --audit-level=moderate",
    "prod:check": "npm run lint && npm run typecheck && npm test && npm run build && npm run audit:prod"
  },
  "dependencies": {
    "@prisma/client": "^6.8.0",
    "clsx": "^2.1.1",
    "next": "^16.2.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.16.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.2.6",
    "postcss": "^8.5.14",
    "prisma": "^6.8.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
